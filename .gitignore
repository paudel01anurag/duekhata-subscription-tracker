# Python
__pycache__/
.pytest_cache/

# Editor
.vscode/

# Build output. Executables are published as GitHub release assets rather than
# committed, so the repository does not grow by ~24 MB on every build.
build/
dist/
*.spec

# Personal data. expenses.db holds real financial records and the local account
# credentials, so it must never be committed.
expenses.db
expenses.json

# Scratch files kept out of the history
Color problem.png
main_error.txt
python_test.py
tkinter_test.py

# Manual source snapshots, superseded by git tags
versions/

# Assistant working notes. Kept locally; not useful to anyone reading the repo.
aristotle/

# Data backups taken before a reset. Local only.
backup-*/

# Assistant working files. These serve Aristotle rather than a human reader,
# so they stay out of the public repository.
CLAUDE.md
CLAUDE.local.md
